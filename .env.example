NODE_ENV=production
# Replace with the MongoDB connection string for this deployment.
DB_URI=mongodb://127.0.0.1:27017/trueemit
# Use a long, unique random value.
SECRET=replace-with-a-long-random-secret
# Subdomain identifier used by the TRUEEMIT inspection-centers API.
SHOP_BRANCH=your-subdomain
# Used only when a valid branch has no manager user yet.
INITIAL_ADMIN_PASSWORD=replace-with-a-strong-password
